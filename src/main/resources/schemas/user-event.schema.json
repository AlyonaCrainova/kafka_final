{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserEvent",
  "type": "object",
  "properties": {
    "event_type": { "type": "string", "enum": ["search", "view", "cart", "buy", "review"] },
    "user_id": { "type": "string" },
    "product_id": { "type": "string" },
    "query": { "type": "string" },
    "found": { "type": "integer" },
    "timestamp": { "type": "string" }
  },
  "required": ["event_type", "user_id", "timestamp"]
}
